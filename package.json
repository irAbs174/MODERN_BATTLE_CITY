{
  "name": "tankforge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TANKFORGE — a modern reimagining of the classic top-down arcade tank game.",
  "author": {
    "name": "Abbas Damerchi",
    "url": "https://damerchi.ir"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
